{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lumos-for-astro",
  "compatibility_date": "2026-08-13",

  // The built site. There is no `main`, so this deploys as an assets-only
  // Worker: Cloudflare serves the files and no script runs per request.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },

  // The domain the Worker answers on. `custom_domain` makes Cloudflare create
  // and manage the DNS record for it, so the zone needs to be in this account.
  "routes": [
    {
      "pattern": "lumosframework.timothyricks.com",
      "custom_domain": true,
    },
  ],

  "observability": {
    "enabled": true,
  },
}
