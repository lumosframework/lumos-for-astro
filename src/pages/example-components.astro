  <Section paddingTop="small" paddingBottom="small">
    <ContentWrapper variant="sticky-visual">
      <Eyebrow>sticky-visual</Eyebrow>
      <Heading tag="h2" variant="h3" maxWidth={17}>{heading}</Heading>
      <Paragraph
