        text="Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod."
        buttonHref="/about"
        buttonLabel="Learn More"
        theme="dark"
        variant="cover"
        image={lumos_background}
      />
      <Card
        heading="Heading"
        text="Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod."
        buttonHref="/about"
        buttonLabel="Learn More"
        variant="stacked"
        image={lumos_background}
      />
    </Grid>
  </Section>
</Layout>
