    <ContentWrapper centered={true}>
      <Eyebrow>modal</Eyebrow>
      <Heading tag="h2" variant="h3" maxWidth={17}>{heading}</Heading>
      <Paragraph maxWidth={36}>{text}</Paragraph>
      <ButtonWrapper>
        <Button data-modal-open="modal-small">Open Modal</Button>
        <Button data-modal-open="modal-side" emphasis="secondary">
          Open Side Panel
        </Button>
        <Button data-modal-open="modal-full" emphasis="secondary">
          Open Full Screen
        </Button>
      </ButtonWrapper>
    </ContentWrapper>
  </Section>
  <!-- small -->

  <Modal id="modal-small" label="Small modal">
    <ContentWrapper centered={true}>
      <Heading tag="h2" variant="h4">{heading}</Heading>
      <Paragraph>{text}</Paragraph>
      <ButtonWrapper>
        <Button element="link" href="/about">Button Text</Button>
      </ButtonWrapper>
    </ContentWrapper>
  </Modal>
  <!-- side panel -->

  <Modal id="modal-side" label="Side panel" variant="side-panel">
    <ContentWrapper>
      <Heading tag="h2" variant="h4">{heading}</Heading>
      <Paragraph>{text}</Paragraph>
      <ButtonWrapper>
        <Button element="link" href="/about">Button Text</Button>
      </ButtonWrapper>
    </ContentWrapper>
  </Modal>
  <!-- full screen -->

  <Modal id="modal-full" label="Full screen" variant="full-screen">
    <ContentWrapper centered={true}>
      <Heading tag="h2" variant="h3">{heading}</Heading>
      <Paragraph>{text}</Paragraph>
      <ButtonWrapper>
        <Button element="link" href="/about">Button Text</Button>
      </ButtonWrapper>
    </ContentWrapper>
  </Modal>
</Layout>
