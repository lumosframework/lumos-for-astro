        text="Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod."
        buttonHref="/about"
        buttonLabel="Button Text"
        theme="dark"
        variant="cover"
        image={lumos_background}
      />
      <Card
        heading="Heading"
        text="Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod."
        buttonHref="/about"
        buttonLabel="Button Text"
        variant="stacked"
        image={lumos_background}
      />
    </Grid>
  </Section>
  <!-- form -->
  <Section paddingTop="small" paddingBottom="small">
    <ContentWrapper>
      <Eyebrow>form</Eyebrow>
    </ContentWrapper>
    <Form name="contact">
      <FormFieldset legend="Contact Details" variant="columns">
        <FormInput variant="first-name" required />
        <FormInput variant="last-name" required />
        <FormInput
          variant="email"
          label="Email Address"
          placeholder="email@company.com"
          required
        />
        <Grid medium={2}>
          <FormSelect label="State" options={states} />
          <FormInput variant="zip-code" placeholder="" />
        </Grid>
        <FormFieldset legend="Date of Birth" variant="thirds">
          <FormSelect variant="month" labelHidden={true} />
          <FormSelect variant="day" labelHidden={true} />
          <FormSelect variant="year" from={1920} labelHidden={true} />
        </FormFieldset>
        <FormInput
          variant="phone"
          label="Phone Number"
          placeholder="000-000-0000"
        />
      </FormFieldset>

      <FormFieldset legend="Legend" variant="columns">
        <FormFieldset legend="Favorite Color" variant="inline">
          <FormChoice type="radio" name="colour" label="Red" value="red" />
          <FormChoice type="radio" name="colour" label="Green" value="green" />
          <FormChoice
            type="radio"
            name="colour"
            label="Blue"
            value="blue"
            checked
          />
        </FormFieldset>
        <FormFieldset legend="Terms & Conditions" variant="inline">
          <FormChoice label="I agree to the terms" name="terms" checked={true} />
          <FormChoice label="I agree to the terms" name="updates" />
        </FormFieldset>
        <FormSelect label="Job Title" options={jobs} />
        <FormInput variant="date" label="Completion Date" />
        <FormRange label="Label" unit="%" />
        <FormTextarea label="Message" placeholder="Your message" required />
      </FormFieldset>

      <ButtonWrapper marginTop="4">
        <Button type="submit">Submit</Button>
      </ButtonWrapper>
    </Form>
  </Section>
  <!-- buttons -->
  <Section paddingTop="small" paddingBottom="small">
    <ContentWrapper>
      <Eyebrow>buttons</Eyebrow>
      <Heading tag="h2" variant="h3" maxWidth={17}>{heading}</Heading>
      <ButtonWrapper>
        <Button element="link" href="/about">Button Text</Button>
        <Button emphasis="secondary">Button Text</Button>
        <Button emphasis="link">Button Text</Button>
      </ButtonWrapper>
      <ButtonWrapper>
        <Button variant="arrow" direction="back" />
        <Button variant="arrow" />
        <Button variant="play" />
        <Button variant="play" pressed={true} />
        <Button variant="close" />
      </ButtonWrapper>
      <ButtonWrapper>
        <Button variant="arrow" emphasis="secondary" direction="back" />
        <Button variant="arrow" emphasis="secondary" />
        <Button variant="play" emphasis="secondary" />
        <Button variant="play" emphasis="secondary" pressed />
        <Button variant="close" emphasis="secondary" />
      </ButtonWrapper>
    </ContentWrapper>
  </Section>
  <!-- tabs horizontal -->
  <Section paddingTop="small" paddingBottom="small">
    <ContentWrapper>
      <Eyebrow>tabs · horizontal</Eyebrow>
      <Heading tag="h2" variant="h3" maxWidth={17}>{heading}</Heading>
    </ContentWrapper>
    <Tabs>
      <Fragment slot="links">
        <TabLink>Strategy</TabLink>
        <TabLink>Design</TabLink>
        <TabLink>Development</TabLink>
      </Fragment>
      <ContentWrapper variant="columns">
        <Heading tag="h3" variant="h4" maxWidth={17}>"Strategy"</Heading>
        <Paragraph maxWidth={36}>{text}</Paragraph>
        <ButtonWrapper>
          <Button element="link" href="/about">Button Text</Button>
        </ButtonWrapper>
        <Img slot="column2" src={lumos_background} width={1920} height={1080} />
