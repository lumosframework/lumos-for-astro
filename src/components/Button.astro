---
import type { HTMLAttributes } from "astro/types";
import Icon from "@/components/Icon.astro";
import arrow from "@/assets/icons/arrow-full.svg";
import close from "@/assets/icons/close.svg";
import play from "@/assets/icons/play.svg";
import pause from "@/assets/icons/pause.svg";
import { slotContent } from "@/utils/slots.ts";

type Emphasis = "primary" | "secondary";

type Tag =
  | (HTMLAttributes<"button"> & {
      element?: "button";
      type?: "button" | "submit" | "reset";
      disabled?: boolean;
      href?: never;
    })
  | (Omit<HTMLAttributes<"a">, "type"> & {
      element: "link";
      href?: string;
      type?: never;
      disabled?: never;
    });

type Kind =
  | {
      variant?: "main";
      /**
       * How much weight the button carries.
       *
       * - `primary` — filled, for the main action (default)
       * - `secondary` — outlined, for anything sitting beside a primary
       * - `link` — text on a rule that travels across on hover
       */
      emphasis?: Emphasis | "link";
      label?: never;
      direction?: never;
    }
  | {
      variant: "play";
      emphasis?: Emphasis;
      /** What the control does, for anyone who cannot see its mark. Defaults to `Play`, or `Pause` when pressed is `true`. */
      label?: string;
      /** Whether it is playing: shows the pause mark, and reads as pressed. Defaults to `false`. */
      pressed?: boolean;
      direction?: never;
    }
  | {
      variant: "close";
      emphasis?: Emphasis;
      /** What the control does, for anyone who cannot see its mark. Defaults to `Close`. */
      label?: string;
      pressed?: never;
      direction?: never;
    }
  | {
      variant: "arrow";
      emphasis?: Emphasis;
      /** What the control does, for anyone who cannot see its mark. Defaults to `Next`, or `Previous` when direction is `back`. */
      label?: string;
      pressed?: never;
      /** Which way the arrow points. Defaults to `forward`. */
      direction?: "forward" | "back";
    };

type Props = {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
} & Tag &
  Kind;

type AllProps = HTMLAttributes<"button"> &
  Omit<HTMLAttributes<"a">, "type"> & {
    render?: boolean;
    variant?: "main" | "play" | "close" | "arrow";
    emphasis?: Emphasis | "link";
    label?: string;
    pressed?: boolean;
    direction?: "forward" | "back";
    element?: "button" | "link";
    href?: string;
    type?: "button" | "submit" | "reset";
  };

const {
  render = true,
  variant = "main",
  emphasis = "primary",
  label,
  pressed = false,
  direction = "forward",
  element = "button",
  href,
  type = "button",
  class: className,
  ...rest
} = Astro.props as AllProps;

const isLink = element === "link";
const Tag = isLink ? "a" : "button";
const tagAttrs = isLink
  ? { href: href || "#" }
  : { type: type === "submit" ? undefined : type };

const marks = { play, close, arrow };
const isMain = variant === "main";
const content = isMain ? await slotContent(Astro.slots) : "";

const named = {
  play: pressed ? "Pause" : "Play",
  close: "Close",
  arrow: direction === "back" ? "Previous" : "Next",
};
---

{
  render && (isMain ? content : true) && (
    <Tag
      class:list={[
        "button",
        emphasis !== "primary" && emphasis,
        !isMain && variant,
        variant === "arrow" && direction === "back" && "back",
        className,
      ]}
      aria-label={isMain ? undefined : (label ?? named[variant])}
      aria-pressed={variant === "play" ? pressed : undefined}
      {...tagAttrs}
      {...rest}
    >
      {isMain && (
        <span class="button_text text-style-trim">
          <Fragment set:html={content} />
        </span>
      )}
      {variant === "play" && (
        <Fragment>
          <Icon class="button_mark button_play" src={play} variant="small" />
          <Icon class="button_mark button_pause" src={pause} variant="small" />
        </Fragment>
      )}
      {variant === "close" && (
        <Icon class="button_mark" src={marks.close} variant="small" />
      )}
      {variant === "arrow" && (
        <Icon class="button_mark" src={marks.arrow} variant="small" />
      )}
    </Tag>
  )
}

<style is:global>
  @layer components {
    .button {
      display: inline-flex;
      justify-content: center;
      align-items: center;
      gap: 0.5em;
      padding: 0.75em 1.5em;
      background-color: var(--button-background);
      color: var(--button-text);
      border: var(--border-width) solid var(--button-border);
      border-radius: 0.5em;
      line-height: 1.2;
      text-decoration: none;
      text-align: center;
      transition:
        background-color var(--hover-duration) var(--hover-ease),
        color var(--hover-duration) var(--hover-ease),
        border-color var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          background-color: var(--button-background-hover);
          color: var(--button-text-hover);
          border-color: var(--button-border-hover);
        }
      }
      &.secondary {
        --button-background: var(--button-2-background);
        --button-text: var(--button-2-text);
        --button-border: var(--button-2-border);
        --button-background-hover: var(--button-2-background-hover);
        --button-text-hover: var(--button-2-text-hover);
        --button-border-hover: var(--button-2-border-hover);
      }
      &.link {
        --button-background: transparent;
        --button-text: var(--link-text);
        --button-border: var(--link-border);
        --button-background-hover: transparent;
        --button-text-hover: var(--link-text-hover);
        --button-border-hover: var(--link-border);

        position: relative;
        padding: 0.4em 0;
        border: 0;
        border-bottom: var(--border-width) solid var(--button-border);
        border-radius: 0;
        &::after {
          content: "";
          position: absolute;
          inset-inline: 0;
          bottom: calc(var(--border-width) * -1);
          height: var(--border-width);
          background-color: var(--link-border-hover);
          transform: scaleX(0);
          transform-origin: right;
          transition: transform calc(var(--hover-duration) * 2)
            var(--hover-ease);
        }
        @media (hover: hover) {
          &:hover::after {
            transform: scaleX(1);
            transform-origin: left;
          }
        }
      }
      /* A mark on its own, so the padding is even and the shape is round. */
      &:is(.play, .close, .arrow) {
        gap: 0;
        padding: 0.75em;
        border-radius: var(--radius-round);
      }
      &.back .button_mark {
        rotate: 180deg;
      }
      &.play .button_pause {
        display: none;
      }
      &.play[aria-pressed="true"] {
        & .button_play {
          display: none;
        }
        & .button_pause {
          display: block;
        }
      }
      &:disabled {
        cursor: not-allowed;
        opacity: 0.5;
      }
    }
  }
</style>
