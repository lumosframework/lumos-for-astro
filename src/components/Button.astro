---
import type { HTMLAttributes } from "astro/types";
import { slotContent } from "@/utils/slots.ts";

type ButtonProps = HTMLAttributes<"button"> & {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /**
   * How much weight the button carries.
   *
   * - `primary` — filled, for the main action (default)
   * - `secondary` — outlined, for anything sitting beside a primary
   * - `link` — text on a rule that travels across on hover
   */
  variant?: "primary" | "secondary" | "link";
  element?: "button";
  type?: "button" | "submit" | "reset";
  disabled?: boolean;
  href?: never;
};

type LinkProps = Omit<HTMLAttributes<"a">, "type"> & {
  render?: boolean;
  variant?: "primary" | "secondary" | "link";
  element: "link";
  href?: string;
  type?: never;
  disabled?: never;
};

type Props = ButtonProps | LinkProps;

const {
  render = true,
  variant = "primary",
  element = "button",
  href,
  type = "button",
  ...rest
} = Astro.props;
const isLink = element === "link";
const Tag = isLink ? "a" : "button";
const tagAttrs = isLink
  ? { href: href || "#" }
  : { type: type === "submit" ? undefined : type };

const content = await slotContent(Astro.slots);
---

{
  render && content && (
    <Tag
      class:list={["button", variant !== "primary" && variant]}
      {...tagAttrs}
      {...rest}
    >
      <span class="button_text text-style-trim">
        <slot />
      </span>
    </Tag>
  )
}

<style is:global>
  @layer components {
    .button {
      display: inline-flex;
      justify-content: center;
      align-items: center;
      gap: 0.5em;
      padding: 0.75em 1.5em;
      background-color: var(--button-background);
      color: var(--button-text);
      border: var(--border-width) solid var(--button-border);
      border-radius: 0.5em;
      line-height: 1.2;
      text-decoration: none;
      text-align: center;
      transition:
        background-color 200ms,
        color 200ms,
        border-color 200ms;
      @media (hover: hover) {
        &:hover {
          background-color: var(--button-background-hover);
          color: var(--button-text-hover);
          border-color: var(--button-border-hover);
        }
      }
      &.secondary {
        --button-background: var(--button-2-background);
        --button-text: var(--button-2-text);
        --button-border: var(--button-2-border);
        --button-background-hover: var(--button-2-background-hover);
        --button-text-hover: var(--button-2-text-hover);
        --button-border-hover: var(--button-2-border-hover);
      }
      &.link {
        --button-background: transparent;
        --button-text: var(--link-text);
        --button-border: var(--link-border);
        --button-background-hover: transparent;
        --button-text-hover: var(--link-text-hover);
        /* The border itself holds still — the sliding line carries the hover color. */
        --button-border-hover: var(--link-border);

        position: relative;
        padding: 0 0 0.4em;
        border: 0;
        border-bottom: var(--border-width) solid var(--button-border);
        border-radius: 0;
        /*
         * The sliding line sits on top of the resting border. It grows from
         * the left on hover, then collapses to the right on hover out, which
         * reads as one line travelling left to right in both directions.
         */
        &::after {
          content: "";
          position: absolute;
          inset-inline: 0;
          bottom: calc(var(--border-width) * -1);
          height: var(--border-width);
          background-color: var(--link-border-hover);
          transform: scaleX(0);
          transform-origin: right;
          transition: transform 400ms;
        }
        @media (hover: hover) {
          &:hover::after {
            transform: scaleX(1);
            transform-origin: left;
          }
        }
      }
      &:disabled {
        cursor: not-allowed;
        opacity: 0.5;
      }
    }
  }
</style>
