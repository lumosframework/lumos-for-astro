---
import type { HTMLAttributes } from "astro/types";
import { slug } from "@/utils/text.ts";
import Icon from "@/components/Icon.astro";
import arrow from "@/assets/icons/arrow.svg";

type SelectOption = string | { value: string; label: string };

type Base = {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** The text above the field. Defaults to the wording of the variant. */
  label?: string;
  /** Which option starts out chosen. */
  value?: string;
  /** The name it submits under. Taken from the label where it is not set. */
  name?: string;
  /** The text shown before a choice is made. Defaults to the wording of the variant. */
  placeholder?: string;
  /** Marks the field as needed, and stars its label. */
  required?: boolean;
  /** Keeps the label for a screen reader, and takes it off the page. */
  labelHidden?: boolean;
};

type Props = HTMLAttributes<"select"> &
  Base &
  (
    | {
        variant?: "list";
        /** What there is to choose from. A plain string is its own label. */
        options: SelectOption[];
        from?: never;
        to?: never;
      }
    | {
        variant: "month" | "day" | "state";
        options?: never;
        from?: never;
        to?: never;
      }
    | {
        variant: "year";
        options?: never;
        /** The earliest year offered. Defaults to a hundred before `to`. */
        from?: number;
        /** The latest year offered. Defaults to the year this was built. */
        to?: number;
      }
  );

type AllProps = HTMLAttributes<"select"> &
  Base & {
    variant?: "list" | "month" | "day" | "year" | "state";
    options?: SelectOption[];
    from?: number;
    to?: number;
  };

const {
  render = true,
  label,
  value,
  variant = "list",
  options,
  from,
  to,
  name,
  placeholder,
  required = false,
  labelHidden = false,
  class: className,
  ...rest
} = Astro.props as AllProps;

const WORDING = {
  list: { label: "Select", placeholder: "Select one…" },
  month: { label: "Month", placeholder: "MM" },
  day: { label: "Day", placeholder: "DD" },
  state: { label: "State", placeholder: "Select one…" },
  year: { label: "Year", placeholder: "YYYY" },
};

/* The fifty states, by the codes a form is filled in with and the names it is
   read in. Neither the District of Columbia nor the territories are here: a
   field that asks for a state is not always the field that should offer them,
   and a page that wants them can pass its own list. */
const STATES: SelectOption[] = [
  { value: "AL", label: "Alabama" },
  { value: "AK", label: "Alaska" },
  { value: "AZ", label: "Arizona" },
  { value: "AR", label: "Arkansas" },
  { value: "CA", label: "California" },
  { value: "CO", label: "Colorado" },
  { value: "CT", label: "Connecticut" },
  { value: "DE", label: "Delaware" },
  { value: "FL", label: "Florida" },
  { value: "GA", label: "Georgia" },
  { value: "HI", label: "Hawaii" },
  { value: "ID", label: "Idaho" },
  { value: "IL", label: "Illinois" },
  { value: "IN", label: "Indiana" },
  { value: "IA", label: "Iowa" },
  { value: "KS", label: "Kansas" },
  { value: "KY", label: "Kentucky" },
  { value: "LA", label: "Louisiana" },
  { value: "ME", label: "Maine" },
  { value: "MD", label: "Maryland" },
  { value: "MA", label: "Massachusetts" },
  { value: "MI", label: "Michigan" },
  { value: "MN", label: "Minnesota" },
  { value: "MS", label: "Mississippi" },
  { value: "MO", label: "Missouri" },
  { value: "MT", label: "Montana" },
  { value: "NE", label: "Nebraska" },
  { value: "NV", label: "Nevada" },
  { value: "NH", label: "New Hampshire" },
  { value: "NJ", label: "New Jersey" },
  { value: "NM", label: "New Mexico" },
  { value: "NY", label: "New York" },
  { value: "NC", label: "North Carolina" },
  { value: "ND", label: "North Dakota" },
  { value: "OH", label: "Ohio" },
  { value: "OK", label: "Oklahoma" },
  { value: "OR", label: "Oregon" },
  { value: "PA", label: "Pennsylvania" },
  { value: "RI", label: "Rhode Island" },
  { value: "SC", label: "South Carolina" },
  { value: "SD", label: "South Dakota" },
  { value: "TN", label: "Tennessee" },
  { value: "TX", label: "Texas" },
  { value: "UT", label: "Utah" },
  { value: "VT", label: "Vermont" },
  { value: "VA", label: "Virginia" },
  { value: "WA", label: "Washington" },
  { value: "WV", label: "West Virginia" },
  { value: "WI", label: "Wisconsin" },
  { value: "WY", label: "Wyoming" },
];

const pad = (n: number) => String(n).padStart(2, "0");
const span = (start: number, end: number) =>
  Array.from({ length: end - start + 1 }, (_, i) => start + i);

const latest = to ?? new Date().getFullYear();
const earliest = from ?? latest - 100;

const choices: SelectOption[] =
  variant === "state"
    ? STATES
    : variant === "month"
      ? span(1, 12).map(pad)
      : variant === "day"
        ? span(1, 31).map(pad)
        : variant === "year"
          ? span(earliest, latest).reverse().map(String)
          : (options ?? []);

const entries = choices.map((choice) =>
  typeof choice === "string" ? { value: choice, label: choice } : choice,
);

const wording = WORDING[variant];
const text = label ?? wording.label;
---

{
  render && entries.length > 0 && (
    <label class:list={["field", "form-select", className]}>
      <span
        class:list={[
          "field_label text-style-main",
          labelHidden && "visually-hidden",
        ]}
      >
        <span>{text}</span>
        {required && (
          <span class="field_star" aria-hidden="true">
            *
          </span>
        )}
      </span>

      <span class="form-select_control">
        <select
          class="field_control form-select_field text-style-main"
          name={name ?? slug(text)}
          required={required || undefined}
          {...rest}
        >
          <option value="" disabled selected={value === undefined} hidden>
            {placeholder ?? wording.placeholder}
          </option>
          {entries.map((entry) => (
            <option value={entry.value} selected={entry.value === value}>
              {entry.label}
            </option>
          ))}
        </select>
        <Icon class="form-select_mark" src={arrow} variant="small" />
      </span>
    </label>
  )
}

<style is:global>
  @layer components {
    .form-select_control {
      position: relative;
      display: block;
    }

    .form-select_field {
      appearance: none;
      padding-inline-end: 3em;
      /* An unmade choice reads as a placeholder, not as an answer. */
      &:has(option[value=""]:checked) {
        color: var(--text-2);
      }
    }

    /* The mark the browser would draw is turned off above, so this one is
       drawn instead — and kept out of the way of the pointer, which belongs
       to the field underneath it. */
    .form-select_mark {
      position: absolute;
      inset-inline-end: 1em;
      top: 50%;
      translate: 0 -50%;
      rotate: 90deg;
      pointer-events: none;
      color: var(--text-2);
    }

    /* Where a browser hands the list over, it becomes a panel like any other:
       the same surface, the same radius, the same opening motion as a dropdown
       or a modal, instead of whatever the operating system draws. Every other
       browser keeps its native menu untouched, which is why none of this is
       written outside the query. */
    @supports (appearance: base-select) {
      .form-select_field,
      .form-select_field::picker(select) {
        appearance: base-select;
      }

      /* The browser offers an arrow of its own once it owns the list. Ours is
         already over the field, and it is the one the rest of the site uses. */
      .form-select_field::picker-icon {
        display: none;
      }

      .form-select_field {
        /* Once the select lays out its own content, that content needs putting
           in the middle of the height the padding gives it. */
        display: flex;
        align-items: center;
        /* The leading trim every text style lays down is meant for a run of
           prose, and a select was never subject to it: nothing renders inside
           a control the browser draws itself. Drawing its own content puts the
           two trim rows inside it, where they drag the text off centre. */
        &::before,
        &::after {
          content: none;
        }
      }

      .form-select_mark {
        transition: rotate var(--open-duration) var(--open-ease);
      }

      .form-select_field:open ~ .form-select_mark {
        rotate: -90deg;
      }

      /* Open, the field and its list are one thing rather than a control and a
         panel that happen to be near each other: the same lifted surface, and
         no gap or corner between them. */
      .form-select_field:open {
        background-color: var(--background-3);
        border-end-start-radius: 0;
        border-end-end-radius: 0;
      }

      .form-select_field::picker(select) {
        /* Both block sides: the browser turns the list over to open upwards
           when there is no room below it, and the gap has to turn with it. */
        margin-block: 0;
        padding: var(--space-1);
        /* Long enough to read a list from, short enough to stay a menu. Left
           alone it stretches to the edge of the viewport, which for fifty
           states means a menu the height of the window — and a menu that tall
           will reach the nav, which nothing can paint over it. */
        max-height: min(18rem, calc(100dvh - 6rem));
        /* The browser would otherwise open it on whichever side has the most
           room, which for a field in the upper half of the page means opening
           upwards over everything above it. Under the field unless it will not
           fit there, which capping the height above makes the usual case. */
        position-try-order: normal;
        overscroll-behavior: contain;
        background-color: var(--background-3);
        border: 0;
        /* Square where it meets the field, so the two read as one panel rather
           than as two chips pinched together. Which pair to square is a guess:
           the browser can turn the list over when there is no room below, and
           a corner is not one of the things @position-try is allowed to set,
           so it cannot be turned over with it. Under the field is the ordinary
           case, and this is squared for it. */
        border-radius: var(--radius-small);
        border-start-start-radius: 0;
        border-start-end-radius: 0;
        /* Growing from its middle rather than sliding from an edge, since
           which edge it is anchored to is not settled until it opens. */
        opacity: 0;
        scale: 0.98;
        transition:
          opacity var(--open-duration) var(--open-ease),
          scale var(--open-duration) var(--open-ease),
          overlay var(--open-duration) var(--open-ease) allow-discrete,
          display var(--open-duration) var(--open-ease) allow-discrete;
      }

      .form-select_field:open::picker(select) {
        opacity: 1;
        scale: 1;
      }

      /* A panel in the top layer has no state to animate from until it is
         opened, so it is given one. */
      @starting-style {
        .form-select_field:open::picker(select) {
          opacity: 0;
          scale: 0.98;
        }
      }

      /* A row in a menu, not a field in a form: a step down in size and the
         tight leading a list wants, so eight of them are in view rather than
         four. */
      .form-select_field option {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        padding: var(--space-1) var(--space-2);
        font-size: var(--text-small);
        line-height: var(--line-height-large);
        color: var(--text);
        background-color: transparent;
        border-radius: var(--radius-small);
        cursor: pointer;
        transition: background-color var(--hover-duration) var(--hover-ease);
        /* The list is the lifted surface now, so a row under the pointer steps
           back towards the field's own rather than further away from it. */
        &:hover,
        &:focus {
          background-color: var(--background-2);
          outline: 0;
        }
      }

      /* A hidden option is kept out of the native menu by the attribute alone.
         The list a browser draws for itself honours the paint, not the
         attribute, so the placeholder is taken out of it here — it is the
         prompt above the choices, not one of them. The button still reads it,
         since what it shows is a copy rather than the option itself. */
      .form-select_field option[hidden] {
        display: none;
      }

      /* The tick belongs at the end of the row it marks, not in front of the
         word it is about. */
      .form-select_field option::checkmark {
        order: 1;
        margin-inline-start: auto;
        color: var(--text-2);
      }
    }
  }
</style>
