---
import { SITE_LOCALE } from "@/consts.ts";

interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** The date to render. Nothing is output if it is missing or invalid. */
  date: Date;
  /** BCP 47 locale tag. Defaults to `SITE_LOCALE`. */
  locale?: string;
  /**
   * IANA time zone. Defaults to UTC so a date-only value never shifts by a day
   * depending on the machine that built the site.
   */
  timeZone?: string;
  /** Formatting options passed to `Intl.DateTimeFormat`. Defaults to `{ dateStyle: "long" }`. */
  format?: Intl.DateTimeFormatOptions;
}

const {
  render = true,
  date,
  locale = SITE_LOCALE,
  timeZone = "UTC",
  format = { dateStyle: "long" },
} = Astro.props;

const isValid = date instanceof Date && !Number.isNaN(date.getTime());

if (import.meta.env.DEV && !isValid) {
  console.warn(
    "[lumos] <FormattedDate> rendered without a valid `date`; nothing was output.",
  );
}

const formatted = isValid
  ? new Intl.DateTimeFormat(locale, { ...format, timeZone }).format(date)
  : "";
---

{render && isValid && <time datetime={date.toISOString()}>{formatted}</time>}
