---
import type { HTMLAttributes } from "astro/types";
import Icon from "@/components/Icon.astro";
import arrow from "@/assets/icons/arrow.svg";
import { slotContent } from "@/utils/slots.ts";

type Props = HTMLAttributes<"div"> & {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** The text on the control that opens it. */
  label?: string;
};

const { render = true, label, class: className, ...rest } = Astro.props;

const content = await slotContent(Astro.slots);
---

{
  render && label && content && (
    <details class:list={["dropdown", className]} {...rest}>
      <summary class="dropdown_toggle">
        <span class="dropdown_label text-style-main">{label}</span>
        <Icon class="dropdown_icon" src={arrow} variant="small" />
      </summary>

      <div class="dropdown_content">
        <div class="dropdown_body margin-trim">
          <Fragment set:html={content} />
        </div>
      </div>
    </details>
  )
}

<script>
  for (const dropdown of document.querySelectorAll<HTMLDetailsElement>(
    ".dropdown",
  )) {
    const summary = dropdown.querySelector<HTMLElement>(".dropdown_toggle");
    const content = dropdown.querySelector<HTMLElement>(".dropdown_content");
    if (!summary || !content) continue;

    document.addEventListener("keydown", (event) => {
      if (!dropdown.open) return;

      if (event.key === "Escape") {
        dropdown.open = false;
        summary.focus();
        return;
      }

      const forward = event.key === "ArrowDown";
      if (!forward && event.key !== "ArrowUp") return;
      if (!dropdown.contains(document.activeElement)) return;

      const items = [
        ...content.querySelectorAll<HTMLElement>(
          "a[href], button:not(:disabled)",
        ),
      ];
      if (items.length === 0) return;

      event.preventDefault();
      const from = items.indexOf(document.activeElement as HTMLElement);
      const step = forward ? 1 : -1;
      const next =
        from === -1
          ? forward
            ? 0
            : items.length - 1
          : (from + step + items.length) % items.length;
      items[next].focus();
    });

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!dropdown.open || !(target instanceof Node)) return;
      if (!dropdown.contains(target)) dropdown.open = false;
    });
  }
</script>

<style is:global>
  @layer components {
    .dropdown {
      --_control-pad: 0.75em;
      position: relative;
      z-index: 10;
      display: inline-block;
    }

    .dropdown_toggle {
      display: inline-flex;
      align-items: center;
      gap: 0.5em;
      padding: var(--_control-pad) 0;
      color: inherit;
      list-style: none;
      cursor: pointer;
      transition: color var(--hover-duration) var(--hover-ease);
      &::-webkit-details-marker {
        display: none;
      }
      @media (hover: hover) {
        &:hover {
          color: color-mix(in lab, currentcolor 60%, transparent);
        }
      }
    }

    .dropdown_icon {
      flex: none;
      rotate: 90deg;
      transition: rotate var(--open-duration) var(--open-ease);
    }

    .dropdown[open] .dropdown_icon {
      rotate: -90deg;
    }

    /* The panel is laid out by this element and revealed by the pseudo the
       browser wraps it in, which is the part that can be animated open. */
    .dropdown::details-content {
      opacity: 0;
      content-visibility: hidden;
      transition:
        opacity var(--open-duration) var(--open-ease),
        content-visibility var(--open-duration) var(--open-ease) allow-discrete;
    }

    .dropdown[open]::details-content {
      opacity: 1;
      content-visibility: visible;
    }

    .dropdown_content {
      position: absolute;
      top: calc(100% - var(--_control-pad) + var(--space-2));
      inset-inline-start: 0;
      width: max-content;
      min-width: 100%;
      max-width: min(22rem, calc(100vw - var(--site-margin) * 2));
      background-color: var(--background-2);
      border-radius: var(--radius-small);
      translate: 0 -0.25rem;
      transition: translate var(--open-duration) var(--open-ease);
    }

    .dropdown[open] .dropdown_content {
      translate: 0 0;
    }

    .dropdown_body {
      padding: var(--space-5);
    }
  }
</style>
