---
import type { HTMLAttributes } from "astro/types";
import { slotContent } from "@/utils/slots.ts";

type Base = HTMLAttributes<"div"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
};

type Props = Base &
  (
    | {
        /** Grid mode. */
        variant?: "columns";
        /**
         * Columns below 30rem: a number for equal columns, or one span or range per child on 12 columns, separated by spaces, like `"4 4 3 1"` or `"1/4 6/12"`. Defaults to `1`.
         */
        xsmall?: string | number;
        /**
         * Columns from 30rem: a number for equal columns, or one span or range per child on 12 columns, separated by spaces, like `"4 4 3 1"` or `"1/4 6/12"`. Inherits `xsmall`.
         */
        small?: string | number;
        /**
         * Columns from 48rem: a number for equal columns, or one span or range per child on 12 columns, separated by spaces, like `"4 4 3 1"` or `"1/4 6/12"`. Inherits `small`.
         */
        medium?: string | number;
        /**
         * Columns from 64rem: a number for equal columns, or one span or range per child on 12 columns, separated by spaces, like `"4 4 3 1"` or `"1/4 6/12"`. Inherits `medium`.
         */
        large?: string | number;
        maxColumnCount?: never;
        minColumnWidth?: never;
      }
    | {
        variant: "autofit" | "autofill";
        /**
         * Maximum columns. Defaults to `12`.
         *
         * @min 1
         * @max 12
         * @int
         */
        maxColumnCount?: number;
        /** Minimum column width in rem. Defaults to `12`.
         *
         * @min 1 */
        minColumnWidth?: number;
        xsmall?: never;
        small?: never;
        medium?: never;
        large?: never;
      }
  );

type AllProps = Base & {
  variant?: "columns" | "autofit" | "autofill";
  xsmall?: string | number;
  small?: string | number;
  medium?: string | number;
  large?: string | number;
  maxColumnCount?: number;
  minColumnWidth?: number;
};

const {
  render = true,
  variant = "columns",
  xsmall = 1,
  small,
  medium,
  large,
  maxColumnCount,
  minColumnWidth,
  class: className,
  ...rest
} = Astro.props as AllProps;

const content = await slotContent(Astro.slots);

const validMinColumnWidth =
  minColumnWidth !== undefined &&
  Number.isFinite(minColumnWidth) &&
  minColumnWidth > 0;

if (
  import.meta.env.DEV &&
  minColumnWidth !== undefined &&
  !validMinColumnWidth
) {
  console.warn(
    `[lumos] <Grid minColumnWidth={${minColumnWidth}}> must be greater than 0; the default is used instead.`,
  );
}

const parseLayout = (name: string, value: string) => {
  const tokens = value.trim().split(/\s+/).filter(Boolean);
  if (!tokens.length) {
    if (import.meta.env.DEV) {
      console.warn(
        `[lumos] <Grid ${name}=""> needs at least one token; the breakpoint is ignored.`,
      );
    }
    return undefined;
  }
  return tokens.map((token) => {
    if (token === "auto") return "auto";
    const span = /^(\d+)$/.exec(token);
    if (span && +span[1] >= 1 && +span[1] <= 12) return `span ${span[1]}`;
    const range = /^(\d+)[/-](\d+)$/.exec(token);
    if (range && +range[1] >= 1 && +range[1] <= +range[2] && +range[2] <= 12) {
      return `${range[1]} / ${+range[2] + 1}`;
    }
    if (import.meta.env.DEV) {
      console.warn(
        `[lumos] <Grid ${name}="${value}"> has an invalid token "${token}"; use a span (1-12) or a range like "7/12". It falls back to auto.`,
      );
    }
    return "auto";
  });
};

const breakpoints = (
  [
    ["xs", "xsmall", xsmall, ""],
    ["sm", "small", small, "(width >= 30rem)"],
    ["md", "medium", medium, "(width >= 48rem)"],
    ["lg", "large", large, "(width >= 64rem)"],
  ] as const
).map(([key, name, raw, query]) => {
  const value =
    typeof raw === "string" && /^\s*\d+\s*$/.test(raw) ? Number(raw) : raw;
  return {
    key,
    value,
    query,
    placements:
      variant === "columns" && typeof value === "string"
        ? parseLayout(name, value)
        : undefined,
  };
});

const columnVars = breakpoints.map(({ key, value, placements }) =>
  placements
    ? `--_cols-${key}: 12`
    : typeof value === "number" &&
      !(key === "xs" && value === 1) &&
      `--_cols-${key}: ${value}`,
);

let inheritedLayout = false;
const layoutRules = breakpoints.flatMap(({ key, value, query, placements }) => {
  let rules: string[] = [];
  if (placements) {
    rules = [
      ...(inheritedLayout
        ? ["& > :nth-child(n of :not(style)) { grid-column: auto; }"]
        : []),
      ...placements.map(
        (placement, i) =>
          `& > :nth-child(${placements.length}n + ${i + 1} of :not(style)) { grid-column: ${placement}; }`,
      ),
    ];
    inheritedLayout = true;
  } else if (typeof value === "number" && key !== "xs" && inheritedLayout) {
    rules = ["& > :nth-child(n of :not(style)) { grid-column: auto; }"];
    inheritedLayout = false;
  }
  if (!rules.length) return [];
  return [query ? `@media ${query} { ${rules.join(" ")} }` : rules.join(" ")];
});

const hash = (text: string) => {
  let h = 5381;
  for (let i = 0; i < text.length; i++) h = (h * 33) ^ text.charCodeAt(i);
  return (h >>> 0).toString(36);
};

const layoutClass = layoutRules.length
  ? `grid-layout-${hash(layoutRules.join(""))}`
  : undefined;

const layoutCss =
  layoutClass &&
  `@layer components { .${layoutClass} { ${layoutRules.join(" ")} } }`;

const columns =
  (variant !== "columns"
    ? [
        maxColumnCount !== undefined && `--_max-cols: ${maxColumnCount}`,
        validMinColumnWidth && `--_min-col-width: ${minColumnWidth}`,
      ]
    : columnVars
  )
    .filter(Boolean)
    .join("; ") || undefined;
---

{render && content && (
  <div
    class:list={[
      "grid",
      variant !== "columns" && variant,
      layoutClass,
      className,
    ]}
    style={columns}
    {...rest}
  >
    {layoutCss && <style is:inline set:html={layoutCss} />}
    <Fragment set:html={content} />
  </div>
)}

<style is:global>
  @layer components {
    .grid {
      --_cols: var(--_cols-xs);
      --_cols-xs: 1;
      --_cols-sm: var(--_cols-xs);
      --_cols-md: var(--_cols-sm);
      --_cols-lg: var(--_cols-md);
      --_gap-size: var(--site-gutter);
      width: 100%;
      display: grid;
      grid-column-gap: var(--_gap-size);
      grid-row-gap: var(--_gap-size);
      grid-template-columns: repeat(var(--_cols), minmax(0, 1fr));
      @media (width >= 30rem) {
        --_cols: var(--_cols-sm);
      }
      @media (width >= 48rem) {
        --_cols: var(--_cols-md);
      }
      @media (width >= 64rem) {
        --_cols: var(--_cols-lg);
      }
      &:is(.autofit, .autofill) {
        --_max-cols: 12;
        --_min-col-width: 12;
        --_fit: calc(
          (100% - (var(--_max-cols) - 1) * var(--_gap-size)) / var(--_max-cols)
        );
        --_track: min(
          max(calc(var(--_min-col-width) * 1rem), var(--_fit)),
          100%
        );
      }
      &.autofit {
        grid-template-columns: repeat(auto-fit, minmax(var(--_track), 1fr));
      }
      &.autofill {
        grid-template-columns: repeat(auto-fill, minmax(var(--_track), 1fr));
      }
    }
  }
</style>
