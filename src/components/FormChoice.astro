---
import type { HTMLAttributes } from "astro/types";
import Icon from "@/components/Icon.astro";
import check from "@/assets/icons/check.svg";
import { slug } from "@/utils/text.ts";

type Base = {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** The text beside the control, and what it is called. */
  label?: string;
  /** What it submits when it is chosen. Defaults to `on`. */
  value?: string;
};

/* What the control is comes before how it is drawn: a radio is one of a group
   where a checkbox stands on its own, which is why only a radio is made to say
   the name it shares. */
type Kind =
  | {
      /** Whether it stands on its own or belongs to a group. Defaults to `checkbox`. */
      type?: "checkbox";
      /** The name it submits under. Taken from the label where it is not set. */
      name?: string;
    }
  | {
      /** Whether it stands on its own or belongs to a group. Defaults to `checkbox`. */
      type: "radio";
      /** The name every choice in the group shares, which is what groups them. */
      name: string;
    };

type Settings = {
  /**
   * How the control is drawn.
   *
   * - `default` — a box or a circle beside the text
   * - `toggle` — a switch that slides
   * - `button` — the whole of it reads as one button, and fills when chosen
   */
  variant?: "default" | "toggle" | "button";
  /** Whether it starts out chosen. */
  checked?: boolean;
  /** Marks the choice as needed. */
  required?: boolean;
};

type Props = Omit<HTMLAttributes<"input">, "type" | "value"> &
  Base &
  Kind &
  Settings;

type AllProps = Omit<HTMLAttributes<"input">, "type" | "value"> &
  Base & { type?: "checkbox" | "radio"; name?: string } & Settings;

const {
  render = true,
  label,
  value,
  type = "checkbox",
  name,
  variant = "default",
  checked = false,
  required = false,
  class: className,
  ...rest
} = Astro.props as AllProps;
---

{
  render && label && (
    <label
      class:list={[
        "form-choice",
        variant !== "default" && `form-choice-${variant}`,
        className,
      ]}
    >
      <input
        class="form-choice_input"
        type={type}
        name={name ?? slug(label)}
        value={value}
        checked={checked || undefined}
        required={required || undefined}
        {...rest}
      />
      <span class="form-choice_mark" aria-hidden="true">
        {type === "radio" ? (
          <span class="form-choice_dot" />
        ) : (
          <Icon class="form-choice_tick" src={check} variant="small" />
        )}
      </span>
      <span class="form-choice_text text-style-main">{label}</span>
    </label>
  )
}

<style is:global>
  @layer components {
    .form-choice {
      display: inline-flex;
      align-items: center;
      gap: 0.75em;
      cursor: pointer;
    }

    /* Kept where it is rather than hidden away, so it still takes the pointer
       and the caret. What is drawn instead is the mark beside it. */
    .form-choice_input {
      position: absolute;
      width: 1px;
      height: 1px;
      opacity: 0;
      pointer-events: none;
    }

    .form-choice_mark {
      /* The surface a mark is drawn on, and the colour of what is drawn on it.
         A variant that moves the mark onto a different surface sets these
         rather than restating every rule below it. */
      --_mark: var(--background-2);
      --_mark-hover: var(--background-3);
      --_mark-chosen: var(--text);
      --_ink: var(--background);

      flex: none;
      display: grid;
      place-items: center;
      width: 1.5em;
      height: 1.5em;
      background-color: var(--_mark);
      /* Transparent rather than absent, as on a field: the box keeps the size
         it would have with a border, and focus has an edge to colour. */
      border: var(--border-width) solid transparent;
      border-radius: var(--radius-small);
      transition:
        background-color var(--hover-duration) var(--hover-ease),
        border-color var(--hover-duration) var(--hover-ease);
    }

    /* A dot only ever sits in a circle. */
    .form-choice_mark:has(.form-choice_dot) {
      border-radius: var(--radius-round);
    }

    .form-choice_tick {
      color: var(--_ink);
      opacity: 0;
      transition: opacity var(--hover-duration) var(--hover-ease);
    }

    /* A radio fills rather than ticks: a dot cannot be mistaken for a box that
       has been crossed. It grows into place on the clock the tick fades on, so
       neither of them arrives out of nothing. */
    .form-choice_dot {
      width: 1.1em;
      height: 1.1em;
      background-color: var(--_ink);
      border-radius: var(--radius-round);
      scale: 0;
      transition: scale var(--hover-duration) var(--hover-ease);
    }

    .form-choice:has(:checked) {
      & .form-choice_mark {
        background-color: var(--_mark-chosen);
      }
      & .form-choice_tick {
        opacity: 1;
      }
      & .form-choice_dot {
        scale: 1;
      }
    }

    @media (hover: hover) {
      /* Only what has not been chosen lifts. A mark that is already filled has
         nowhere to go, and moving it would read as a change of state. */
      .form-choice:hover .form-choice_input:not(:checked) ~ .form-choice_mark {
        background-color: var(--_mark-hover);
      }
    }

    .form-choice_input:focus-visible ~ .form-choice_mark {
      outline: var(--focus-width) solid var(--text);
      outline-offset: var(--focus-offset);
    }

    /* Toggle: the mark is the track, and the knob travels the length of it. */
    .form-choice-toggle {
      & .form-choice_mark {
        width: 2.75em;
        height: 1.5em;
        border-radius: var(--radius-round);
        place-items: center start;
        padding: 0.15em;
      }
      & :is(.form-choice_tick, .form-choice_dot) {
        display: none;
      }
      & .form-choice_mark::after {
        content: "";
        width: 1.1em;
        height: 1.1em;
        border-radius: var(--radius-round);
        background-color: var(--text);
        transition:
          translate var(--hover-duration) var(--hover-ease),
          background-color var(--hover-duration) var(--hover-ease);
      }
      &:has(:checked) .form-choice_mark::after {
        translate: 1.2em 0;
        background-color: var(--_ink);
      }
    }

    /* Button: the whole of it is the control, so the box it sits in is what
       fills. Its mark stays the colour of the page in either state, so being
       chosen never costs the button its mark. */
    .form-choice-button {
      padding: 0.75em 1.5em;
      background-color: var(--background-2);
      border: var(--border-width) solid transparent;
      border-radius: var(--radius-round);
      transition:
        background-color var(--hover-duration) var(--hover-ease),
        color var(--hover-duration) var(--hover-ease),
        border-color var(--hover-duration) var(--hover-ease);
      & .form-choice_mark {
        --_mark: var(--background);
        --_mark-hover: var(--background);
        --_mark-chosen: var(--background);
        --_ink: var(--text);
      }
      @media (hover: hover) {
        &:hover:not(:has(:checked)) {
          background-color: var(--background-3);
        }
      }
      &:has(:checked) {
        background-color: var(--text);
        color: var(--background);
      }
      & .form-choice_input:focus-visible ~ .form-choice_mark {
        outline: 0;
      }
      &:has(.form-choice_input:focus-visible) {
        outline: var(--focus-width) solid var(--text);
        outline-offset: var(--focus-offset);
      }
    }
  }
</style>
