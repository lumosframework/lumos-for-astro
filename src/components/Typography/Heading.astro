---
import type { HTMLAttributes } from "astro/types";
import { slotContent } from "@/utils/slots.ts";

type HeadingTag = "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
type HeadingStyle =
  | "inherit"
  | "display"
  | "h1"
  | "h2"
  | "h3"
  | "h4"
  | "h5"
  | "h6"
  | "large"
  | "main"
  | "small";

interface Props extends HTMLAttributes<"div"> {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** The heading level, for the page outline. Defaults to `h2`. */
  tag?: HeadingTag;
  /**
   * Type style, chosen apart from `tag` so a heading can change level without
   * changing size. Defaults to matching `tag`.
   *
   * - `display`, `h1`–`h6` — the heading sizes
   * - `large`, `main`, `small` — the body sizes
   * - `inherit` — take the style from its surroundings
   */
  variant?: HeadingStyle;
  /**
   * Longest line, in characters, before the text wraps. Unset, it fills
   * its column.
   *
   * @min 1
   * @int
   */
  maxWidth?: number;
}

const {
  render = true,
  tag = "h2",
  variant = tag,
  maxWidth,
  class: className,
  ...rest
} = Astro.props;

const Tag = tag;

const content = await slotContent(Astro.slots);
---

{
  render && content && (
    <Tag
      class:list={[
        "heading",
        variant !== "inherit" && `text-style-${variant}`,
        className,
      ]}
      style={maxWidth ? `--_mw: ${maxWidth}ch;` : undefined}
      {...rest}
    >
      <Fragment set:html={content} />
    </Tag>
  )
}
