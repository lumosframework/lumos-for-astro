---
import type { HTMLAttributes } from "astro/types";
import { slotContent } from "@/utils/slots.ts";

type ParagraphTag = "p" | "span" | "div";
type ParagraphStyle =
  | "inherit"
  | "display"
  | "h1"
  | "h2"
  | "h3"
  | "h4"
  | "h5"
  | "h6"
  | "large"
  | "main"
  | "small";

interface Props extends HTMLAttributes<"p"> {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** The element the text is written as. Defaults to `p`. */
  tag?: ParagraphTag;
  /**
   * Type style.
   *
   * - `display`, `h1`–`h6` — the heading sizes
   * - `large`, `main`, `small` — the body sizes
   * - `inherit` — take the style from its surroundings (default)
   */
  variant?: ParagraphStyle;
  /**
   * Longest line, in characters, before the text wraps. Unset, it fills
   * its column.
   *
   * @min 1
   * @int
   */
  maxWidth?: number;
}

const {
  render = true,
  tag = "p",
  variant = "inherit",
  maxWidth,
  class: className,
  ...rest
} = Astro.props;

const Tag = tag;

const content = await slotContent(Astro.slots);
---

{
  render && content && (
    <Tag
      class:list={[
        "text",
        variant !== "inherit" && `text-style-${variant}`,
        className,
      ]}
      style={maxWidth ? `--_mw: ${maxWidth}ch;` : undefined}
      {...rest}
    >
      <Fragment set:html={content} />
    </Tag>
  )
}
