---
import type { HTMLAttributes } from "astro/types";
import Eyebrow from "@/components/Eyebrow.astro";
import Heading from "@/components/Heading.astro";
import Paragraph from "@/components/Paragraph.astro";
import Button from "@/components/Button.astro";
import ButtonWrapper from "@/components/ButtonWrapper.astro";
import Img from "@/components/Img.astro";
import Overlay from "@/components/Overlay.astro";

type CardVariant = "default" | "cover" | "stacked";
type CardTheme = "inherit" | "light" | "dark" | "brand" | "invert";
type HeadingTag = "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
type ImageSource = ImageMetadata | string;

type Base = HTMLAttributes<"div"> & {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** Small line of text above the heading. */
  eyebrow?: string;
  /** The card's title. */
  heading?: string;
  /** Heading level, for the page outline. Every card heading is the same size. */
  headingTag?: HeadingTag;
  /** Body copy under the heading. */
  text?: string;
  /** Label of the closing button. Nothing renders without one. */
  buttonLabel?: string;
  /** Where the button leads. Left out, it renders as a plain button. */
  buttonHref?: string;
  /**
   * Where the image sits.
   *
   * - `default` — no image, text only (default)
   * - `cover` — image fills the card, text over it
   * - `stacked` — image above the text, bleeding to the edges
   */
  variant?: CardVariant;
  /** Colors the card carries with it, whatever section it sits in. */
  theme?: CardTheme;
};

type Props = Base &
  (
    | {
        variant?: "default";
        image?: never;
        imageAlt?: never;
      }
    | {
        variant: "cover";
        /** An imported asset, a remote `http(s)` URL, or a path to a file in `public/`. */
        image?: ImageSource;
        /** Leave unset on a decorative image — renders `alt=""`. */
        imageAlt?: string;
      }
    | {
        variant: "stacked";
        /** A stacked card has no surface of its own, so it keeps the theme around it. */
        theme?: never;
        /** An imported asset, a remote `http(s)` URL, or a path to a file in `public/`. */
        image?: ImageSource;
        /** Leave unset on a decorative image — renders `alt=""`. */
        imageAlt?: string;
      }
  );

type AllProps = Base & {
  image?: ImageSource;
  imageAlt?: string;
};

const {
  render = true,
  eyebrow,
  heading,
  headingTag = "h3",
  text,
  buttonLabel,
  buttonHref,
  variant = "default",
  theme = "inherit",
  image,
  imageAlt,
  class: className,
  ...rest
} = Astro.props as AllProps;

const hasImage = variant !== "default" && !!image;
const hasContent = !!(eyebrow || heading || text || buttonLabel);
const hasTheme = variant !== "stacked" && theme !== "inherit";

/* The button each variant closes with, so a set of cards reads as one system. */
const buttonVariant =
  variant === "cover"
    ? "primary"
    : variant === "stacked"
      ? "link"
      : "secondary";

if (import.meta.env.DEV && render) {
  if (variant === "stacked" && theme !== "inherit") {
    console.warn(
      '[lumos] <Card variant="stacked"> has no surface to color, so `theme` was dropped. It keeps the theme around it.',
    );
  }
  if (variant === "default" && image) {
    console.warn(
      '[lumos] <Card variant="default"> holds no image, so `image` was dropped. Use the cover or stacked variant to show it.',
    );
  }
  if (variant !== "default" && !image) {
    console.warn(
      `[lumos] <Card variant="${variant}"> has no \`image\`, so it renders as a plain card.`,
    );
  }
}
---

{
  render && (hasContent || hasImage) && (
    <div
      class:list={[
        "card_wrap",
        variant !== "default" && variant,
        hasTheme && `theme-${theme}`,
        className,
      ]}
      {...rest}
    >
      {hasImage && (
        <div class="card_visual">
          <Img src={image!} alt={imageAlt} />
          {/* A cover card's text sits on the image, so the tint is not optional */}
          {variant === "cover" && <Overlay variant="gradient" />}
        </div>
      )}
      {hasContent && (
        <div class="card_content margin-trim">
          <Eyebrow>{eyebrow}</Eyebrow>
          <Heading tag={headingTag} variant="h5">
            {heading}
          </Heading>
          <Paragraph>{text}</Paragraph>
          <ButtonWrapper>
            {buttonHref ? (
              <Button element="link" href={buttonHref} variant={buttonVariant}>
                {buttonLabel}
              </Button>
            ) : (
              <Button variant={buttonVariant}>{buttonLabel}</Button>
            )}
          </ButtonWrapper>
        </div>
      )}
    </div>
  )
}

<style is:global>
  @layer components {
    .card_wrap {
      --_padding: var(--space-6);
      --_min-height: 20rem;
      --_visual-ratio: 3 / 2;
      width: 100%;
      display: flex;
      flex-direction: column;
      /* Separates the visual from the content. Only the stacked variant feels
         it — a cover card's visual is out of flow, a default card has none. */
      gap: var(--_padding);
      position: relative;
      background-color: var(--background-2);
      border-radius: var(--radius-main);
      overflow: clip;

      &.cover {
        min-height: var(--_min-height);
      }

      /* No surface of its own — the visual is the only thing with edges, and it
         rounds itself, so nothing here needs clipping */
      &.stacked {
        background-color: transparent;
        overflow: visible;
      }
    }

    .card_visual {
      position: relative;
      width: 100%;
      flex: none;
      border-radius: inherit;
      overflow: clip;

      .stacked > & {
        aspect-ratio: var(--_visual-ratio);
      }

      .cover > & {
        position: absolute;
        inset: 0;
        height: 100%;
        pointer-events: none;
      }
    }

    .card_content {
      display: flex;
      flex-direction: column;
      align-items: var(--_alignment, start);
      text-align: var(--_alignment, start);
      flex-grow: 1;
      width: 100%;
      max-width: 100%;
      padding: var(--_padding);

      /* Fills the card like the default variant does, so the text starts at
         the top and the button still lands on the floor. */
      .cover > & {
        position: relative;
        z-index: 1;
      }

      /* Line the text up with the visual's edges. The wrap's gap opens the space
         under the visual, and the bottom padding stays so a stacked card's
         buttons land level with those on the cards beside it. */
      .stacked > & {
        padding-inline: 0;
        padding-top: 0;
      }
    }
  }
</style>
