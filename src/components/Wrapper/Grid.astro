---
import type { HTMLAttributes } from "astro/types";
import { slotContent } from "@/utils/slots.ts";

type Base = HTMLAttributes<"div"> & {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
};

type Props = Base &
  (
    | {
        /**
         * How the columns are decided.
         *
         * - `columns` — a count you set per breakpoint (default)
         * - `autofit` — as many columns as fit, from a minimum width
         * - `autofill` — same, but empty columns keep their space
         */
        variant?: "columns";
        /**
         * Columns below 30rem. The base every larger size falls back to.
         *
         * @min 1
         * @max 12
         * @int
         */
        xsmall?: number;
        /**
         * Columns from 30rem up. Inherits xsmall when unset.
         *
         * @min 1
         * @max 12
         * @int
         */
        small?: number;
        /**
         * Columns from 48rem up. Inherits small when unset.
         *
         * @min 1
         * @max 12
         * @int
         */
        medium?: number;
        /**
         * Columns from 64rem up. Inherits medium when unset.
         *
         * @min 1
         * @max 12
         * @int
         */
        large?: number;
        maxColumnCount?: never;
        minColumnWidth?: never;
      }
    | {
        variant: "autofit" | "autofill";
        /**
         * Never exceed this many columns, however wide the grid gets. Defaults to 12.
         *
         * @min 1
         * @max 12
         * @int
         */
        maxColumnCount?: number;
        /** Smallest a column may get, in rem, before the count drops. Must be greater than 0. Defaults to 12. */
        minColumnWidth?: number;
        xsmall?: never;
        small?: never;
        medium?: never;
        large?: never;
      }
  );

type AllProps = Base & {
  variant?: "columns" | "autofit" | "autofill";
  xsmall?: number;
  small?: number;
  medium?: number;
  large?: number;
  maxColumnCount?: number;
  minColumnWidth?: number;
};

const {
  render = true,
  variant = "columns",
  xsmall = 1,
  small,
  medium,
  large,
  maxColumnCount,
  minColumnWidth,
  class: className,
  ...rest
} = Astro.props as AllProps;

const content = await slotContent(Astro.slots);

const validMinColumnWidth =
  minColumnWidth !== undefined &&
  Number.isFinite(minColumnWidth) &&
  minColumnWidth > 0;

if (
  import.meta.env.DEV &&
  minColumnWidth !== undefined &&
  !validMinColumnWidth
) {
  console.warn(
    `[lumos] <Grid minColumnWidth={${minColumnWidth}}> must be greater than 0; the default is used instead.`,
  );
}

const columns =
  (variant !== "columns"
    ? [
        maxColumnCount !== undefined && `--_max-cols: ${maxColumnCount}`,
        validMinColumnWidth && `--_min-col: ${minColumnWidth}`,
      ]
    : [
        xsmall !== 1 && `--_cols-xs: ${xsmall}`,
        small !== undefined && `--_cols-sm: ${small}`,
        medium !== undefined && `--_cols-md: ${medium}`,
        large !== undefined && `--_cols-lg: ${large}`,
      ]
  )
    .filter(Boolean)
    .join("; ") || undefined;
---

{
  render && content && (
    <div
      class:list={["grid", variant !== "columns" && variant, className]}
      style={columns}
      {...rest}
    >
      <slot />
    </div>
  )
}

<style is:global>
  @layer components {
    .grid {
      --_cols: var(--_cols-xs);
      --_cols-xs: 1;
      --_cols-sm: var(--_cols-xs);
      --_cols-md: var(--_cols-sm);
      --_cols-lg: var(--_cols-md);
      --_gap-size: var(--site-gutter);
      width: 100%;
      display: grid;
      grid-column-gap: var(--_gap-size);
      grid-row-gap: var(--_gap-size);
      grid-template-columns: repeat(var(--_cols), minmax(0, 1fr));
      @media (width >= 30rem) {
        --_cols: var(--_cols-sm);
      }
      @media (width >= 48rem) {
        --_cols: var(--_cols-md);
      }
      @media (width >= 64rem) {
        --_cols: var(--_cols-lg);
      }
      &:is(.autofit, .autofill) {
        --_max-cols: 12;
        --_min-col: 12;
        --_fit: (100% - (var(--_max-cols) - 1) * var(--_gap-size)) /
          var(--_max-cols);
        --_track: min(max(calc(var(--_min-col) * 1rem), var(--_fit)), 100%);
      }
      &.autofit {
        grid-template-columns: repeat(auto-fit, minmax(var(--_track), 1fr));
      }
      &.autofill {
        grid-template-columns: repeat(auto-fill, minmax(var(--_track), 1fr));
      }
    }
  }
</style>
