---
import type { HTMLAttributes } from "astro/types";
import { slotContent } from "@/utils/slots.ts";

type ContentWrapperVariant =
  | "stack"
  | "auto-width"
  | "columns"
  | "breakout"
  | "contain"
  | "sticky-content"
  | "sticky-visual"
  | "card";

type Base = HTMLAttributes<"div"> & {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /**
   * How the two columns are arranged. The default slot is the first column,
   * the `column2` slot the second.
   *
   * - `stack` — one column, everything in order (default)
   * - `auto-width` — a row, each column only as wide as its content
   * - `columns` — two even columns from 64rem up
   * - `breakout` — full viewport width, the visual bleeding off one edge
   * - `contain` — two columns on a filled, rounded surface
   * - `sticky-content` — two columns; the content holds as the visual scrolls
   * - `sticky-visual` — two columns; the visual holds as the content scrolls
   * - `card` — the visual fills the surface, the content centered over it
   */
  variant?: ContentWrapperVariant;
};

type ColumnClasses = {
  /** Classes for the first column, which holds the default slot. */
  column1Class?: string;
  /** Classes for the second column. */
  column2Class?: string;
};

type Props = Base &
  (
    | {
        variant?: "stack";
        reverse?: never;
        /** Center the contents of each column. */
        centered?: boolean;
        mediaOpacity?: never;
      }
    | {
        variant: "auto-width";
        reverse?: never;
        centered?: never;
        mediaOpacity?: never;
      }
    | {
        variant: "columns" | "breakout" | "contain";
        /** Show the second column first. */
        reverse?: boolean;
        centered?: never;
        mediaOpacity?: never;
      }
    | {
        variant: "sticky-content" | "sticky-visual";
        reverse?: never;
        centered?: never;
        mediaOpacity?: never;
      }
    | {
        variant: "card";
        reverse?: never;
        centered?: never;
        /**
         * How visible the card's visual is, as a percentage. Defaults to 70.
         *
         * @min 0
         * @max 100
         * @int
         */
        mediaOpacity?: number;
      }
  ) &
  ColumnClasses;

type AllProps = Base &
  ColumnClasses & {
    variant?: ContentWrapperVariant;
    reverse?: boolean;
    centered?: boolean;
    mediaOpacity?: number;
  };

const {
  render = true,
  variant = "stack",
  reverse = false,
  centered = false,
  mediaOpacity,
  column1Class,
  column2Class,
  class: className,
  ...rest
} = Astro.props as AllProps;

const validMediaOpacity =
  mediaOpacity !== undefined &&
  Number.isFinite(mediaOpacity) &&
  mediaOpacity >= 0 &&
  mediaOpacity <= 100;

if (import.meta.env.DEV && mediaOpacity !== undefined) {
  if (!validMediaOpacity) {
    console.warn(
      `[lumos] <ContentWrapper mediaOpacity={${mediaOpacity}}> must be between 0 and 100; the default is used instead.`,
    );
  } else if (variant !== "card") {
    console.warn(
      `[lumos] <ContentWrapper variant="${variant}"> ignores mediaOpacity; only the card variant has a visual to fade.`,
    );
  }
}

const media =
  variant === "card" && validMediaOpacity && mediaOpacity !== 70
    ? `--_media-opacity: ${mediaOpacity}`
    : undefined;

const variantClasses =
  variant === "stack"
    ? []
    : variant === "card"
      ? ["card-layout", "theme-dark"]
      : [variant];

const column1 = await slotContent(Astro.slots);
const column2 = await slotContent(Astro.slots, "column2");
---

{
  render && (column1 || column2) && (
    <div
      class:list={[
        "layout",
        variantClasses,
        reverse && "reversed",
        centered && "centered",
        className,
      ]}
      style={media}
      {...rest}
    >
      {column1 && (
        <div class:list={[column1Class]}>
          <Fragment set:html={column1} />
        </div>
      )}
      {column2 && (
        <div class:list={[column2Class]}>
          <Fragment set:html={column2} />
        </div>
      )}
    </div>
  )
}

<style is:global>
  @layer components {
    .layout {
      /* layout defaults */
      --_visual-ratio: 3 / 2;
      --_alignment: start;
      --_column-count: 1;
      width: 100%;
      display: flex;
      flex-direction: column;
      column-gap: var(--site-gutter);
      row-gap: var(--space-8);
      align-items: stretch;
      grid-template-columns: repeat(var(--_column-count), minmax(0, 1fr));

      /* column defaults */
      & > * {
        display: flex;
        flex-direction: column;
        align-items: var(--_alignment, start);
        text-align: var(--_alignment, start);
        width: 100%;
        max-width: 100%;
      }
      & > :first-child {
        align-self: center;
      }

      /* visual ratio lock */
      & > :last-child:not(:has(> :not(.image, .video, .overlay))) {
        position: relative;
        border-radius: var(--radius-small);
        aspect-ratio: var(--_visual-ratio);
        & > :is(.image, .video, .overlay) {
          border-radius: inherit;
          position: absolute;
          inset: 0;
          width: 100%;
          height: 100%;
        }
      }

      /* variant overrides */
      &.centered {
        --_alignment: center;
      }
      &.auto-width {
        flex-direction: row;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: end;
        row-gap: var(--space-6);
        & > * {
          width: auto;
          align-self: unset;
        }
        & > :last-child {
          min-width: min(4rem, 100%);
        }
      }
      &.columns {
        display: grid;
        column-gap: var(--section-space-small);
        @media (width >= 64rem) {
          --_column-count: 2;
          &.reversed {
            & > :last-child {
              order: -1;
            }
          }
        }
      }
      &.sticky-content {
        --_visual-ratio: 1 / 1;
        display: grid;
        @media (width >= 64rem) {
          --_column-count: 2;
          & > :first-child {
            align-self: start;
            position: sticky;
            top: calc(var(--site-margin) + var(--nav-height));
          }
        }
      }
      &.sticky-visual {
        --_visual-ratio: 1 / 1;
        display: grid;
        @media (width >= 64rem) {
          --_column-count: 2;
          & > :first-child {
            align-self: start;
          }
          & > :last-child {
            align-self: start;
            position: sticky;
            top: calc(var(--site-margin) + var(--nav-height));
            max-height: calc(
              100svh - var(--nav-height) - var(--site-margin) * 2
            );
          }
        }
      }
      &.breakout {
        display: grid;
        width: 100vw;
        flex-shrink: 0;
        align-self: center;
        column-gap: 0;
        row-gap: 0;
        & > :first-child {
          margin-inline: auto;
          width: var(--site-width);
          padding-block: var(--section-space-medium);
        }
        & > :last-child {
          border-radius: 0;
        }
        @media (width >= 64rem) {
          --_column-count: 2;
          & > :first-child {
            max-width: calc(var(--max-width-main) / 2);
          }
          & > :last-child {
            border-top-left-radius: var(--radius-small);
            border-bottom-left-radius: var(--radius-small);
          }
          &.reversed {
            & > :last-child {
              order: -1;
              border-top-left-radius: 0;
              border-bottom-left-radius: 0;
              border-top-right-radius: var(--radius-small);
              border-bottom-right-radius: var(--radius-small);
            }
          }
        }
      }
      &.contain {
        display: grid;
        column-gap: 0;
        row-gap: 0;
        background-color: var(--background-2);
        border-radius: var(--radius-main);
        position: relative;
        overflow: clip;
        & > :first-child {
          padding: var(--space-6);
        }
        & > :last-child {
          border-radius: 0;
        }
        @media (width >= 64rem) {
          --_column-count: 2;
          &.reversed {
            & > :last-child {
              order: -1;
            }
          }
        }
      }
      &.card-layout {
        border-radius: var(--radius-main);
        position: relative;
        overflow: clip;
        min-height: 26rem;
        justify-content: center;
        & > :first-child {
          padding: var(--space-6);
        }
        & > :first-child {
          padding-block: var(--section-space-medium);
          padding-inline: var(--space-5);
          position: relative;
          z-index: 1;
          --_alignment: center;
        }
        & > :last-child {
          position: absolute;
          inset: 0;
          border-radius: 0;
          width: 100%;
          height: 100%;
          opacity: calc(var(--_media-opacity, 70) / 100);
          pointer-events: none;
        }
      }
    }
  }
</style>
