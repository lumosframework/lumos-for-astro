---
import type { HTMLAttributes } from "astro/types";
import { slotContent } from "@/utils/slots.ts";

type SectionSpace =
  "none" | "even" | "small" | "medium" | "large" | "navoverlap";

type ContainerGap =
  | "0"
  | "1"
  | "2"
  | "3"
  | "4"
  | "5"
  | "6"
  | "7"
  | "8"
  | "small"
  | "medium"
  | "large";

interface Props extends HTMLAttributes<"section"> {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** Colors this section and everything inside it. */
  theme?: "inherit" | "light" | "dark" | "brand";
  /**
   * Space above the content.
   *
   * - `medium` — the usual gap between sections (default)
   * - `none` — flush, for a section that meets the one above it
   * - `even` — the site margin, matching the space at the sides
   * - `small`, `large` — tighter or looser than usual
   * - `navoverlap` — clears a nav sitting over the page
   */
  paddingTop?: SectionSpace;
  /** Space below the content. Takes the same values as `paddingTop`. */
  paddingBottom?: SectionSpace;
  /** Space between the children, from the spacing scale. Defaults to `8`. */
  gap?: ContainerGap;
  /** Where the content sits across the section. Defaults to `start`. */
  align?: "start" | "center" | "end";
  /** Fills the screen's height, however little content there is. */
  fullHeight?: boolean;
  /** Classes for the container inside the section, which sets the width. */
  containerClass?: string;
  /** Attributes for that same container. */
  containerAttrs?: HTMLAttributes<"div">;
}

const {
  render = true,
  theme = "inherit",
  paddingTop = "medium",
  paddingBottom = "medium",
  gap = "8",
  align,
  fullHeight = false,
  containerClass,
  containerAttrs = {},
  class: className,
  ...rest
} = Astro.props;

const { class: containerAttrsClass, ...containerRest } = containerAttrs;

const padSuffix: Partial<Record<SectionSpace, string>> = {
  none: "0",
  even: "sitemargin",
};

const padClass = (side: "top" | "bottom", value: SectionSpace) =>
  !!value &&
  value !== "medium" &&
  `padding-${side}-${padSuffix[value] ?? value}`;

const content = await slotContent(Astro.slots);
const background = await slotContent(Astro.slots, "background");
---

{
  render && (content || background) && (
    <section
      class:list={[
        "section",
        padClass("top", paddingTop),
        padClass("bottom", paddingBottom),
        fullHeight && "min-height-screen",
        theme !== "inherit" && `theme-${theme}`,
        align && `alignment-${align}`,
        className,
      ]}
      {...rest}
    >
      <Fragment set:html={background} />
      {content && (
        <div
          class:list={[
            "container",
            gap !== "8" && `gap-${gap}`,
            containerClass,
            containerAttrsClass,
          ]}
          {...containerRest}
        >
          <Fragment set:html={content} />
        </div>
      )}
    </section>
  )
}
