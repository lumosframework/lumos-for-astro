---
import type { HTMLAttributes } from "astro/types";
import { slotContent } from "@/utils/slots.ts";

type Props = HTMLAttributes<"div"> & {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /**
   * How the label is drawn.
   *
   * - `default` — a marker beside the text (default)
   * - `tag` — no marker; the text sits in a filled pill
   */
  variant?: "default" | "tag";
};

const {
  render = true,
  variant = "default",
  class: className,
  ...rest
} = Astro.props;

const content = await slotContent(Astro.slots);
---

{
  render && content && (
    <div
      class:list={["eyebrow", variant !== "default" && variant, className]}
      {...rest}
    >
      {variant === "default" && (
        <span class="eyebrow_marker" aria-hidden="true" />
      )}
      <p class="eyebrow_text text-style-small">
        <slot />
      </p>
    </div>
  )
}

<style is:global>
  @layer components {
    .eyebrow {
      display: inline-flex;
      align-items: center;
      justify-content: var(--_alignment, start);
      gap: var(--space-2);

      &.tag {
        background-color: var(--text);
        color: var(--background);
        padding: var(--space-1) var(--space-2);
        border-radius: var(--radius-small);
      }
      .eyebrow_marker {
        flex: none;
        width: var(--border-width);
        height: 0.75rem;
        background-color: currentcolor;
      }
    }
  }
</style>
