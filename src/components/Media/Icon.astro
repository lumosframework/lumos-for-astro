---
import type { HTMLAttributes, SvgComponent } from "astro/types";

type IconVariant = "small" | "medium" | "large" | "full-width";

interface Props extends HTMLAttributes<"svg"> {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** An SVG imported from `src/assets`, rendered inline. Nothing is output if it is missing. */
  src?: SvgComponent;
  /**
   * Size, in `em`, so the icon scales with the text beside it.
   *
   * - `small` — 1em, matching the line of text
   * - `medium` — 1.5em (default)
   * - `large` — 2em
   * - `full-width` — fills its container, height follows the artwork
   */
  variant?: IconVariant;
}

const {
  render = true,
  src: Svg,
  variant = "medium",
  class: className,
  ...rest
} = Astro.props;

const labelled = Boolean(rest["aria-label"] ?? rest["aria-labelledby"]);

if (import.meta.env.DEV && render) {
  if (!Svg) {
    console.warn(
      "[lumos] <Icon> rendered without a `src`; nothing was output.",
    );
  }
}
---

{
  render && Svg && (
    <Svg
      class:list={["icon", variant !== "medium" && variant, className]}
      aria-hidden={labelled ? undefined : "true"}
      {...rest}
    />
  )
}

<style is:global>
  @layer components {
    .icon {
      --_size: 1.5em;
      flex: none;
      display: block;
      width: var(--_size);
      height: auto;
      aspect-ratio: 1 / 1;
      max-width: 100%;

      &.small {
        --_size: 1em;
      }

      &.large {
        --_size: 2em;
      }

      &.full-width {
        width: 100%;
        aspect-ratio: unset;
      }
    }
  }
</style>
