---
import type { HTMLAttributes } from "astro/types";

type VideoRatio = "2-1" | "16-9" | "3-2" | "5-4" | "1-1" | "4-5" | "2-3";

type Head = Omit<
  HTMLAttributes<"video">,
  "src" | "poster" | "loop" | "autoplay" | "muted"
> & {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** Video file URL. Nothing is output if it is missing. */
  src?: string;
  /** Still frame shown before playback starts. */
  poster?: string;
};

type Tail = {
  /** Restart from the beginning on reaching the end. */
  loop?: boolean;
  /** Begin playing without interaction. Browsers only permit this while muted. */
  autoplay?: boolean;
  /** Play without sound. Required for autoplay to be allowed. */
  muted?: boolean;
  /** For cutouts: fit the whole frame in rather than cropping, and drop the skeleton tint. */
  transparent?: boolean;
};

type Props = Head &
  (
    | {
        /**
         * Aspect ratio, applied with the matching `ratio-*` utility.
         *
         * - `2-1`, `16-9` — widescreen (`16-9` is the default)
         * - `3-2`, `5-4`, `1-1` — squarer
         * - `4-5`, `2-3` — upright, for a phone
         *
         * `custom` takes a ratio of your own. `auto` matches the file, but its
         * height is unknown until the file's metadata arrives, so the page
         * shifts once it loads.
         */
        variant?: VideoRatio;
        ratio?: never;
      }
    | {
        variant: "custom";
        /** Any CSS `aspect-ratio` value, such as `21 / 9` or `1.85`. */
        ratio?: string;
      }
    | {
        variant: "auto";
        ratio?: never;
      }
  ) &
  Tail;

type AllProps = Head &
  Tail & {
    variant?:
      | "2-1"
      | "16-9"
      | "3-2"
      | "5-4"
      | "1-1"
      | "4-5"
      | "2-3"
      | "custom"
      | "auto";
    ratio?: string;
  };

const {
  render = true,
  src,
  poster,
  variant = "16-9",
  ratio,
  loop = true,
  autoplay = true,
  muted = true,
  transparent = false,
  class: className,
  ...rest
} = Astro.props as AllProps;

if (import.meta.env.DEV && render) {
  if (!src) {
    console.warn(
      "[lumos] <Video> rendered without a `src`; nothing was output.",
    );
  }
  if (autoplay && !muted) {
    console.warn(
      "[lumos] <Video autoplay> without `muted` is blocked by every major browser. Set muted, or drop autoplay and let the viewer start it.",
    );
  }
  if (variant === "custom" && !ratio) {
    console.warn(
      '[lumos] <Video variant="custom"> has no `ratio`, so no aspect ratio is applied. Set one, or pick a preset variant.',
    );
  }
}

const isCustom = variant === "custom";
---

{
  render && src && (
    <video
      src={src}
      poster={poster}
      class:list={[
        "video",
        !isCustom && `ratio-${variant}`,
        transparent && "transparent",
        className,
      ]}
      style={isCustom && ratio ? `aspect-ratio: ${ratio};` : undefined}
      loop={loop}
      autoplay={autoplay}
      muted={muted}
      playsinline
      {...rest}
    />
  )
}
