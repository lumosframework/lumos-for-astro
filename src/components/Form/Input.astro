---
import type { HTMLAttributes } from "astro/types";
import { slug } from "@/utils/text.ts";

type InputVariant =
  | "text"
  | "first-name"
  | "last-name"
  | "email"
  | "phone"
  | "date"
  | "zip-code"
  | "number"
  | "search"
  | "password"
  | "url";

interface Props extends Omit<HTMLAttributes<"input">, "type"> {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** The text above the field. Defaults to the wording of the variant. */
  label?: string;
  /** What the field starts out holding. */
  value?: string;
  /**
   * What the field is for. It settles the input's type, keyboard, autofill
   * and wording together, so a field only has to say which one it is.
   *
   * - `text` — anything else, with no assumptions (default)
   * - `first-name`, `last-name`, `zip-code` — autofilled from an address
   * - `email`, `phone`, `url`, `number`, `date` — a keyboard and validation
   *   to match
   * - `search`, `password` — the browser's own handling of each
   */
  variant?: InputVariant;
  /** The name it submits under. Taken from the label where it is not set. */
  name?: string;
  /** The text shown in an empty field. Defaults to the wording of the variant. */
  placeholder?: string;
  /** Marks the field as needed, and stars its label. */
  required?: boolean;
  /** Keeps the label for a screen reader, and takes it off the page. */
  labelHidden?: boolean;
}

const {
  render = true,
  label,
  value,
  variant = "text",
  name,
  placeholder,
  required = false,
  labelHidden = false,
  class: className,
  ...rest
} = Astro.props;

type InputAttrs = HTMLAttributes<"input">;

const KINDS: Record<
  InputVariant,
  {
    label: string;
    type: NonNullable<InputAttrs["type"]>;
    mode: NonNullable<InputAttrs["inputmode"]>;
    fill: NonNullable<InputAttrs["autocomplete"]>;
  }
> = {
  text: { label: "Text", type: "text", mode: "text", fill: "on" },
  "first-name": {
    label: "First Name",
    type: "text",
    mode: "text",
    fill: "given-name",
  },
  "last-name": {
    label: "Last Name",
    type: "text",
    mode: "text",
    fill: "family-name",
  },
  email: { label: "Email", type: "email", mode: "email", fill: "email" },
  phone: { label: "Phone", type: "tel", mode: "tel", fill: "tel" },
  date: { label: "Date", type: "date", mode: "text", fill: "bday" },
  "zip-code": {
    label: "Zip Code",
    type: "text",
    mode: "numeric",
    fill: "postal-code",
  },
  number: { label: "Number", type: "number", mode: "numeric", fill: "off" },
  search: { label: "Search", type: "search", mode: "search", fill: "off" },
  password: {
    label: "Password",
    type: "password",
    mode: "text",
    fill: "current-password",
  },
  url: { label: "URL", type: "url", mode: "url", fill: "url" },
};

const kind = KINDS[variant];
const text = label ?? kind.label;
---

{
  render && (
    <label class:list={["field", "form-input", className]}>
      <span
        class:list={["field-label text-style-main", labelHidden && "sr-only"]}
      >
        <span>{text}</span>
        {required && (
          <span class="field-star" aria-hidden="true">
            *
          </span>
        )}
      </span>
      <input
        class="field-control text-style-main"
        type={kind.type}
        name={name ?? slug(text)}
        placeholder={placeholder ?? text}
        inputmode={kind.mode}
        autocomplete={kind.fill}
        required={required || undefined}
        value={value}
        {...rest}
      />
    </label>
  )
}
