---
import type { HTMLAttributes } from "astro/types";
import { slotContent } from "@/utils/slots.ts";

interface Props extends HTMLAttributes<"fieldset"> {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** What the fields inside have in common, named above them. */
  legend?: string;
  /**
   * How the fields inside are set out. Each column arrangement stacks below
   * the width `Grid` calls medium.
   *
   * - `stack` — one under another (default)
   * - `columns` — two abreast
   * - `thirds` — three abreast
   * - `inline` — in a row that wraps, for a run of choices
   */
  variant?: "stack" | "columns" | "thirds" | "inline";
  /**
   * How the legend is set.
   *
   * - `heading` — larger and heavier than a field's label (default)
   * - `label` — the weight of a field's label, for a group inside a group
   * - `hidden` — read out but not shown, where the fields say it themselves
   */
  legendStyle?: "heading" | "label" | "hidden";
}

const {
  render = true,
  legend,
  variant = "stack",
  legendStyle = "heading",
  class: className,
  ...rest
} = Astro.props;

const LEGEND_STYLES: Record<NonNullable<Props["legendStyle"]>, string> = {
  heading: "text-style-h5",
  label: "field-label text-style-main",
  hidden: "sr-only",
};

const content = await slotContent(Astro.slots);
---

{
  render && legend && content && (
    <fieldset
      class:list={["form-fieldset", variant !== "stack" && variant, className]}
      {...rest}
    >
      <legend
        class:list={[
          "form-fieldset_legend",
          `form-fieldset_legend-${legendStyle}`,
          LEGEND_STYLES[legendStyle],
        ]}
      >
        {legend}
      </legend>
      <div class="form-fieldset_fields">
        <Fragment set:html={content} />
      </div>
    </fieldset>
  )
}

<style is:global>
  @layer components {
    .form-fieldset {
      width: 100%;
      min-width: 0;
      padding: 0;
      border: 0;
    }

    .form-fieldset_legend {
      padding: 0;
      margin-bottom: var(--space-2);
    }

    .form-fieldset_legend-heading {
      margin-bottom: var(--space-3);
    }

    .form-fieldset_fields {
      display: grid;
      gap: var(--space-5);

      .form-fieldset.inline & {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-3) var(--space-5);
        > * {
          width: auto;
        }
      }

      @media (width >= 48rem) {
        .form-fieldset.columns & {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
        .form-fieldset.thirds & {
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }
      }
    }
  }
</style>
