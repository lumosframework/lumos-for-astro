# Kept out of `git archive` tarballs, so sites scaffolded with `npm create
# lumos` and downloads of the source archive don't inherit the framework's
# own contributor tooling or deploy target. Clones and forks still get
# everything — export-ignore only applies to archives.

/.gitattributes export-ignore
/.github export-ignore
/.claude export-ignore
/packages export-ignore
/CLA.md export-ignore
/CONTRIBUTING.md export-ignore
/wrangler.jsonc export-ignore
